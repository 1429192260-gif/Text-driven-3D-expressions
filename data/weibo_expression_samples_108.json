    "params": {
      "mouthFrownLeft": 0.37,
      "mouthFrownRight": 0.4,
      "browInnerUp": 0.36,
      "eyeSquintLeft": 0.14,
      "eyeSquintRight": 0.16
    },
    "source": "weibo_mined",
    "source_label": "1"
  },
  {
    "text": "都在休息，我们却在上班，郁闷！！！",
    "emotion": "sad",
